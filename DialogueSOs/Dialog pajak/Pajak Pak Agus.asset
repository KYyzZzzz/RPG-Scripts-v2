  m_Script: {fileID: 11500000, guid: e171e0b70afc99e4bb9947d8c34d1efe, type: 3}
  m_Name: Pajak Pak Agus
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 9f36a98c5a30586408162d7112e88533, type: 2}
    text: Salam, petualang! Apakah kamu melihat Andika? Pandai besi itu pandai menempa
      pedang legendaris, tapi lebih berbakat lagi dalam jurus menghilang tiap kali
      jadwal pencatatan pajak kerajaan tiba!
  options:
  - optionText: Tanya fungsi pencatatan gulungan pajak
    nextDialogue: {fileID: 11400000, guid: 4f62416252633ae43ab53878ab80ffc6, type: 2}
  - optionText: Tolak membantu mencari Andika
    nextDialogue: {fileID: 11400000, guid: dc77317635efdc242917a4a286b1d97a, type: 2}
  requiredNPCs: []
  requiredLocations: []
  requiredItems: []
