  m_Script: {fileID: 11500000, guid: e171e0b70afc99e4bb9947d8c34d1efe, type: 3}
  m_Name: Jelaskan Fungsi Pajak Ke andika
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: fb085a33d691acc4381c2bb88139d98c, type: 2}
    text: Bukan untuk mahkota, kawan! Pajakmu dipakai menggaji prajurit penjaga gerbang.
      Kalau gerbang jebol, monster liar bakal datang memesan pedang tanpa bayar.
  - speaker: {fileID: 11400000, guid: d24ae28fa3fd5a34a9163d7863be08d5, type: 2}
    text: Hmm... benar juga. Terakhir kali gerbang jebol, para goblin malah mencuri
      landasan besiku untuk pesta barbekyu. Baiklah, aku akan segara membayar pajak.
  options: []
  requiredNPCs: []
  requiredLocations: []
  requiredItems: []
