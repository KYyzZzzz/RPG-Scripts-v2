  m_Script: {fileID: 11500000, guid: e171e0b70afc99e4bb9947d8c34d1efe, type: 3}
  m_Name: Bertemu Andika
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d24ae28fa3fd5a34a9163d7863be08d5, type: 2}
    text: Aduh, pinggangku mau patah! Memukul logam seharian cuma menghasilkan koin
      receh, masa kastil masih tega minta jatah upeti?
  - speaker: {fileID: 11400000, guid: fb085a33d691acc4381c2bb88139d98c, type: 2}
    text: Pak Agus mencarimu, Andika. Bawa gulungan kas tokomu sebelum dia mengirim
      regu pengawal.
  - speaker: {fileID: 11400000, guid: d24ae28fa3fd5a34a9163d7863be08d5, type: 2}
    text: Paling koin pajaknya cuma dipakai Sang Raja beli mahkota baru yang lebih
      berkilau!
  options:
  - optionText: Jelaskan fungsi pajak untuk keamanan & benteng
    nextDialogue: {fileID: 11400000, guid: 48c463c9a038ecb4fa7003aa9ee69c81, type: 2}
  - optionText: Peringatkan soal sanksi razia bengkel
    nextDialogue: {fileID: 11400000, guid: 718df108be7854f469b9c7684dc95471, type: 2}
  requiredNPCs:
  - {fileID: 11400000, guid: 9f36a98c5a30586408162d7112e88533, type: 2}
  requiredLocations: []
  requiredItems: []
