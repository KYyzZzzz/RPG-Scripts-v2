MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e171e0b70afc99e4bb9947d8c34d1efe, type: 3}
  m_Name: Greeting With Jamal
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: b311f222570e45c43b669ac3874e7ef4, type: 2}
    text: Bentar, bentar... Kamu beneran mau nekat masuk ke Sarang Goblin cuma modal
      gaya gitu, Sir Up Marjanus?
  - speaker: {fileID: 11400000, guid: fb085a33d691acc4381c2bb88139d98c, type: 2}
    text: Tentu saja, Jamal! Kesatria sejati tidak pernah mundur. Aku bakal ratakan
      itu goblin-goblin hijau!
  - speaker: {fileID: 11400000, guid: b311f222570e45c43b669ac3874e7ef4, type: 2}
    text: Pake pedang berkarat sama baju zirah yang bunyinya udah kayak kaleng rombeng
      gitu? Kamu bukan mau perang, kamu cuma nganterin diri buat jadi jatah makan
      siang mereka!
  - speaker: {fileID: 11400000, guid: fb085a33d691acc4381c2bb88139d98c, type: 2}
    text: Heh, jaga mulutmu! Ini baju zirah gaya vintage, dan pedangku ini punya
      nilai estetika. Lagian, 90% kemenangan perang itu berasal dari rasa percaya
      diri!
  - speaker: {fileID: 11400000, guid: b311f222570e45c43b669ac3874e7ef4, type: 2}
    text: Terserah kamulah! Tapi aku yakin goblin-goblin itu bakal takjub banget...
      tepat sebelum mereka jadiin helm mengkilapmu itu mangkok soto.
  - speaker: {fileID: 11400000, guid: fb085a33d691acc4381c2bb88139d98c, type: 2}
    text: Halah, bacot! Kamu kira aku takut? Mau bukti kalau aku bisa ratain sarang
      itu sendirian?
  options:
  - optionText: Tantang!
    nextDialogue: {fileID: 11400000, guid: 2607f788656fa71428ddd5e4e9b7cf92, type: 2}
  - optionText: Mengalah
    nextDialogue: {fileID: 11400000, guid: ceb1b4d2e088d5f4b8238b473db5812b, type: 2}
