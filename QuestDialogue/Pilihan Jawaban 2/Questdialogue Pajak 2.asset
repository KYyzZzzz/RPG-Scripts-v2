  m_Script: {fileID: 11500000, guid: e171e0b70afc99e4bb9947d8c34d1efe, type: 3}
  m_Name: Questdialogue Pajak 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 7b77f2e09c2e67943974c8df9cbf4f21, type: 2}
    text: Keberanian yang bagus! Dengarkan baik-baik. Kastil reyot tempatmu menyimpan
      loot rongsokan itu berdiri di atas tanah kerajaan. Tahukah kau, pajak tahunan
      apa yang ditarik kerajaan atas tanah dan bangunanmu itu?
  options:
  - optionText: Pajak Bobo Bareng (PBB), Tuanku!
    nextDialogue: {fileID: 11400000, guid: 8573c8ee5d0454e4b9a799586db74e47, type: 2}
    offerQuest: {fileID: 0}
  - optionText: Pajak Biskuit Berdarah (PBB)!
    nextDialogue: {fileID: 11400000, guid: 987aa7ceafb71f541a354565c1717e13, type: 2}
    offerQuest: {fileID: 0}
  - optionText: Pajak Bumi dan Bangunan (PBB)!
    nextDialogue: {fileID: 11400000, guid: 4eeee60d5482f174899f9ce8a9e285f0, type: 2}
    offerQuest: {fileID: 0}
